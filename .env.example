# Copy to .env.local and fill in. Every key is OPTIONAL — the app fully runs
# without any of them (concierge + merchant pitches fall back to local
# generation; the voice call falls back to a transcript-only view).

# Live Claude — powers the consumer concierge and the merchant proposal/email
# generation on the supply-side ops dashboard (/merchant).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs — makes the merchant voice-agent pitch audible in /merchant.
ELEVENLABS_API_KEY=
# Optional: override the default voice ("Rachel").
ELEVENLABS_VOICE_ID=

# Google Places (new Places API) — live merchant discovery on /merchant/supply.
# Without it, "Discover" returns the sample supply graph.
GOOGLE_PLACES_API_KEY=
